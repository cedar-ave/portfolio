# codespell config, read automatically when codespell runs from the repo root.
# Checks prose only: code files and generated folders are skipped.
# Add false positives to ignore-words-list (lowercase, comma-separated).
[codespell]
skip = ./.git,./node_modules,./build,./.docusaurus,./static,./_archive,./src/pages/portfolio/_archive,./Claude outputs,*.js,*.jsx,*.ts,*.tsx,*.css,*.json,*.svg
ignore-words-list = categor,pre-selected,sme,wit
